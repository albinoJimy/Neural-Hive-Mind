        "type": "tags"
      },
      {
        "datasource": "$datasource",
        "enable": true,
        "expr": "increase(orchestration_ml_training_jobs_total{status=\"failed\"}[5m]) > 0",
        "hide": false,
        "iconColor": "rgba(255, 0, 0, 1)",
