{
  "dashboard": {
    "id": null,
    "title": "Fluxo H - Cutover Status Dashboard",
    "tags": ["fluxo-h", "cutover", "traffic", "rollback"],
    "timezone": "browser",
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Current Traffic Distribution",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "cutover_traffic_percentage",
            "legendFormat": "Target System",
            "instant": true
          },
          {
            "datasource": "prometheus",
            "expr": "100 - cutover_traffic_percentage",
            "legendFormat": "Legacy System",
            "instant": true
          }
        ],
        "options": {
          "pieType": "donut",
          "tooltip": { "mode": "single", "sort": "none" },
          "legend": { "displayMode": "table", "placement": "right" }
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 2,
        "title": "Target Traffic Percentage",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "cutover_traffic_percentage",
            "legendFormat": "Target %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "blue", "value": 0},
                {"color": "purple", "value": 25},
                {"color": "yellow", "value": 50},
                {"color": "orange", "value": 75},
                {"color": "green", "value": 100}
              ]
            }
          }
        },
        "options": {
          "orientation": "auto",
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 3,
        "title": "Total RPS Comparison",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "sum(rate(http_requests_total{system=\"target\"}[1m]))",
            "legendFormat": "Target System"
          },
          {
            "datasource": "prometheus",
            "expr": "sum(rate(http_requests_total{system=\"legacy\"}[1m]))",
            "legendFormat": "Legacy System"
          },
          {
            "datasource": "prometheus",
            "expr": "sum(rate(http_requests_total{system=~\"target|legacy\"}[1m]))",
            "legendFormat": "Total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 4,
        "title": "Traffic Percentage Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "cutover_traffic_percentage",
            "legendFormat": "Target Traffic %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 5,
        "title": "Error Rate Comparison",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "sum(rate(http_requests_total{system=\"target\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{system=\"target\"}[5m])) * 100",
            "legendFormat": "Target Error %"
          },
          {
            "datasource": "prometheus",
            "expr": "sum(rate(http_requests_total{system=\"legacy\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{system=\"legacy\"}[5m])) * 100",
            "legendFormat": "Legacy Error %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "orange", "value": 5},
                {"color": "red", "value": 10}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Latency Comparison (P95)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{system=\"target\"}[5m])) by (le))",
            "legendFormat": "Target P95"
          },
          {
            "datasource": "prometheus",
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{system=\"legacy\"}[5m])) by (le))",
            "legendFormat": "Legacy P95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 7,
        "title": "System Health Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "up{job=\"target-system\"}",
            "legendFormat": "Target"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {"text": "DOWN", "color": "red"},
                  "1": {"text": "UP", "color": "green"}
                }
              }
            ]
          }
        },
        "options": {
          "colorMode": "background"
        }
      },
      {
        "id": 8,
        "title": "Legacy System Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 24},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "up{job=\"legacy-system\"}",
            "legendFormat": "Legacy"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {"text": "DOWN", "color": "red"},
                  "1": {"text": "UP", "color": "green"}
                }
              }
            ]
          }
        },
        "options": {
          "colorMode": "background"
        }
      },
      {
        "id": 9,
        "title": "Shadow Mode Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 24},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "cutover_shadow_mode_enabled",
            "legendFormat": "Shadow Mode"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "gray", "value": 0},
                {"color": "blue", "value": 1}
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {"text": "DISABLED"},
                  "1": {"text": "ENABLED"}
                }
              }
            ]
          }
        }
      },
      {
        "id": 10,
        "title": "Cutover Phase",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 24},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "cutover_phase",
            "legendFormat": "Phase"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "blue", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "orange", "value": 2},
                {"color": "green", "value": 3}
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {"text": "PREPARATION"},
                  "1": {"text": "SHADOW"},
                  "2": {"text": "GRADUAL"},
                  "3": {"text": "COMPLETE"}
                }
              }
            ]
          }
        }
      },
      {
        "id": 11,
        "title": "Rollback Events",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "increase(cutover_emergency_rollback_total[5m])",
            "legendFormat": "Emergency Rollbacks"
          },
          {
            "datasource": "prometheus",
            "expr": "increase(cutover_manual_rollback_total[5m])",
            "legendFormat": "Manual Rollbacks"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 12,
        "title": "Recovery Time After Rollback",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "cutover_rollback_recovery_seconds",
            "legendFormat": "Recovery Time"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 13,
        "title": "Traffic Switch Events",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "cutover_traffic_switch_events",
            "legendFormat": "{{event_type}}",
            "format": "table",
            "instant": true
          }
        ],
        "options": {
          "showHeader": true
        }
      },
      {
        "id": 14,
        "title": "Cutover Timeline",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 36},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "changes(cutover_traffic_percentage[1m])",
            "legendFormat": "Traffic Changes"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "palette-classic"}
          }
        }
      }
    ]
  }
}
