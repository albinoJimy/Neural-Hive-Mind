{
  "dashboard": {
    "id": null,
    "title": "Fluxo H - Data Migration Metrics",
    "tags": ["fluxo-h", "data-migration", "8019", "cdc", "batch"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Migration Progress",
        "type": "gauge",
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "(data_migration_jobs_completed_total / data_migration_jobs_total) * 100",
            "legendFormat": "Progress %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 50},
                {"color": "green", "value": 90}
              ]
            }
          }
        },
        "options": {
          "orientation": "auto",
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 2,
        "title": "Jobs Completed/Total",
        "type": "stat",
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "data_migration_jobs_completed_total",
            "legendFormat": "Completed"
          },
          {
            "datasource": "prometheus",
            "expr": "data_migration_jobs_total",
            "legendFormat": "Total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "unit": "short"
          }
        }
      },
      {
        "id": 3,
        "title": "Active Jobs",
        "type": "stat",
        "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "data_migration_jobs_active",
            "legendFormat": "Active"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 5},
                {"color": "red", "value": 10}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Rows Migrated Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "rate(data_migration_rows_migrated_total[5m])",
            "legendFormat": "Rows/sec"
          },
          {
            "datasource": "prometheus",
            "expr": "increase(data_migration_rows_migrated_total[1h])",
            "legendFormat": "Rows/hour"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 5,
        "title": "Batch Throughput",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "rate(data_migration_batch_processed_total[5m])",
            "legendFormat": "Batches/sec"
          },
          {
            "datasource": "prometheus",
            "expr": "rate(data_migration_batch_rows_total[5m])",
            "legendFormat": "Rows in batches/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 6,
        "title": "CDC Events Processing",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "rate(data_migration_cdc_events_total[5m])",
            "legendFormat": "CDC Events/sec"
          },
          {
            "datasource": "prometheus",
            "expr": "data_migration_cdc_lag_seconds",
            "legendFormat": "CDC Lag (sec)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 7,
        "title": "Migration Duration by Job",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "histogram_quantile(0.95, sum(rate(data_migration_job_duration_seconds_bucket[5m])) by (le, job_name))",
            "legendFormat": "{{job_name}} - P95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 8,
        "title": "Validation Results",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "rate(data_migration_validation_passed_total[5m])",
            "legendFormat": "Passed/sec"
          },
          {
            "datasource": "prometheus",
            "expr": "rate(data_migration_validation_failed_total[5m])",
            "legendFormat": "Failed/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 9,
        "title": "Rollback Events",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "increase(data_migration_rollback_total[5m])",
            "legendFormat": "Rollbacks (5m)"
          },
          {
            "datasource": "prometheus",
            "expr": "data_migration_rollback_rows_total",
            "legendFormat": "Rows Rolled Back"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 10,
        "title": "Failed Jobs",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "increase(data_migration_jobs_failed_total[5m])",
            "legendFormat": "Failed Jobs (5m)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Data Validation Failures by Type",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "sum by (failure_type) (rate(data_migration_validation_failed_total[5m]))",
            "legendFormat": "{{failure_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 12,
        "title": "Migration Jobs Status",
        "type": "table",
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 38},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "data_migration_job_status",
            "legendFormat": "{{job_name}}",
            "format": "table",
            "instant": true
          }
        ],
        "options": {
          "showHeader": true
        }
      },
      {
        "id": 13,
        "title": "Throughput Comparison",
        "type": "bargauge",
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 38},
        "targets": [
          {
            "datasource": "prometheus",
            "expr": "rate(data_migration_rows_migrated_total[5m])",
            "legendFormat": "Current Throughput"
          },
          {
            "datasource": "prometheus",
            "expr": "data_migration_target_throughput",
            "legendFormat": "Target Throughput"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 1000},
                {"color": "green", "value": 5000}
              ]
            }
          }
        }
      }
    ]
  }
}
