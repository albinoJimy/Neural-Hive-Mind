          "expr": "avg(rate(http_request_duration_seconds_sum{namespace=\"neural-hive\"}[5m])) * 1000",
          "legendFormat": "Avg Response Time",
          "refId": "A"
        }
      ],
      "title": "Average Response Time",
      "type": "stat"
    },
