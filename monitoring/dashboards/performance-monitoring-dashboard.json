        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["avg"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
