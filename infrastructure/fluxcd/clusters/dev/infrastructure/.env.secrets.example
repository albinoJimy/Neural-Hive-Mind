# Exemplo de arquivo de secrets para desenvolvimento
# Copiar para .env.secrets e preencher com valores reais
# Este arquivo NÃO deve ser commitado no repositório

# Kafka Credentials
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# MongoDB Credentials
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Redis Credentials
REDIS_PASSWORD=

# Temporal Credentials
TEMPORAL_MTLS_CERT=
TEMPORAL_MTLS_KEY=

# Neo4j Credentials
NEO4J_USERNAME=
NEO4J_PASSWORD=

# API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Service Registry
SERVICE_REGISTRY_API_KEY=

# Encryption
ENCRYPTION_KEY=

# Webhooks
SLACK_WEBHOOK_URL=
