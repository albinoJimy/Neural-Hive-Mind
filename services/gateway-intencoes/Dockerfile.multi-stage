# Gateway de Intenções - Neural Hive-Mind
# Multi-stage Dockerfile for optimized image size
# Rebuild: 2026-03-27 - P04 Operacional

# ============================================================================
# BUILDER STAGE - Contains build tools and compilers
# ============================================================================
ARG REGISTRY=ghcr.io/albinojimy
FROM ${REGISTRY}/neural-hive-mind/python-observability-base:1.2.6 AS builder

# Metadados de build
ARG VERSION=1.0.0
ARG BUILD_DATE
ARG VCS_REF

LABEL stage="builder" \
      neural-hive-mind.org/build-stage="builder"

# Instalar dependências de build (gcc, g++, etc)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    gcc \
    g++ \
    libasound2-dev \
    portaudio19-dev \
    ffmpeg \
    git \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Criar diretório de trabalho para build
WORKDIR /build

# Copiar requirements
COPY services/gateway-intencoes/requirements.txt .

# Copiar bibliotecas internas
COPY libraries/python/neural_hive_domain /tmp/neural_hive_domain
COPY libraries/python/neural_hive_observability /tmp/neural_hive_observability

# Instalar dependências Python (incluindo pacotes que precisam de compilação)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir --upgrade pip==24.0 && \
    pip install --no-cache-dir /tmp/neural_hive_domain && \
    pip install --no-cache-dir --force-reinstall /tmp/neural_hive_observability && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir --no-deps openai-whisper && \
    pip install --no-cache-dir \
        https://github.com/explosion/spacy-models/releases/download/pt_core_news_sm-3.7.0/pt_core_news_sm-3.7.0.tar.gz \
        https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.7.1/en_core_web_sm-3.7.1.tar.gz \
        https://github.com/explosion/spacy-models/releases/download/es_core_news_sm-3.7.0/es_core_news_sm-3.7.0.tar.gz

# ============================================================================
# RUNTIME STAGE - Minimal image with only runtime dependencies
# ============================================================================
FROM ${REGISTRY}/neural-hive-mind/python-observability-base:1.2.6 AS runtime

# Metadados da imagem final
LABEL org.opencontainers.image.title="Gateway de Intenções - Neural Hive-Mind" \
      org.opencontainers.image.description="Gateway para captura e processamento de intenções (Multi-stage optimized)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.vendor="Neural Hive-Mind" \
      org.opencontainers.image.source="https://github.com/neural-hive-mind/infrastructure" \
      neural-hive-mind.org/component="gateway-intencoes" \
      neural-hive-mind.org/layer="application" \
      neural-hive-mind.org.build-type="multi-stage"

# Instalar APENAS runtime dependencies (não inclui gcc, g++)
# ffmpeg é necessário para processamento de áudio
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /var/cache/apt/*

# Criar usuário não-root
RUN groupadd -r appgroup && useradd -r -g appgroup -u 1001 appuser

# Definir diretório de trabalho
WORKDIR /app

# Copiar dependências Python instaladas do builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copiar código da aplicação
COPY services/gateway-intencoes/src/ ./src/

# Criar diretórios necessários
RUN mkdir -p /app/logs /app/temp /app/models /app/schemas /app/config

# Copiar schema Avro
COPY schemas/intent-envelope/intent-envelope.avsc /app/schemas/intent-envelope.avsc

# Copiar arquivo de regras NLU
COPY services/gateway-intencoes/config/nlu_rules.yaml /app/config/nlu_rules.yaml

# Ajustar permissões
RUN chown -R appuser:appgroup /app && \
    find /app -type d -exec chmod 755 {} \; && \
    find /app -type f -exec chmod 644 {} \; && \
    chmod +x /app/src/main.py

# Configurações de segurança
USER appuser

# Variáveis de ambiente
ENV PYTHONPATH="/app/src" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TMPDIR="/app/temp" \
    HOME="/app"

WORKDIR /app/src

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
