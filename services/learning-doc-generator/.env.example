# Environment para Learning Documentation Generator

# Aplicação
ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO
SERVICE_NAME=learning-doc-generator
SERVICE_VERSION=1.0.0

# API
API_HOST=0.0.0.0
API_PORT=8009
API_WORKERS=1

# Prometheus
PROMETHEUS_PORT=8089

# OpenTelemetry
OTEL_ENDPOINT=http://otel-collector.neural-hive.svc.cluster.local:4317
OTEL_EXPORTER_OTLP_HEADERS=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=learning-doc-generator
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Kafka Topics
KAFKA_EXPERIMENT_COMPLETED_TOPIC=experiment.completed
KAFKA_MODEL_PROMOTED_TOPIC=model.promoted
KAFKA_DEPLOYMENT_ROLLBACK_TOPIC=deployment.rolled_back
KAFKA_LEARNING_DOC_GENERATED_TOPIC=learning.doc.generated

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=neural_hive
MONGODB_COLLECTION=learning_documents

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TIMEOUT_SECONDS=30

# Document Generation
DOCS_OUTPUT_DIR=/tmp/learning_docs
DOCS_TEMPLATE_DIR=/app/templates
DOCS_INCLUDE_PLOTS=true
DOCS_PLOT_FORMAT=png

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_DAILY_HOUR=9
SCHEDULER_DAILY_MINUTE=0
SCHEDULER_WEEKLY_DAY=0
SCHEDULER_MONTHLY_DAY=1

# Limits
MAX_EXPERIMENTS_PER_DOC=100
DOC_GENERATION_TIMEOUT_SECONDS=300

# Feature Flags
ENABLE_PDF_GENERATION=false
ENABLE_SLACK_NOTIFICATIONS=false

# Slack (opcional)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=
