# Test Generation Service - Environment for Testing

# Service
TEST_GEN_SERVICE_NAME=test-generation
TEST_GEN_SERVICE_VERSION=v0.1.0
TEST_GEN_HOST=0.0.0.0
TEST_GEN_PORT=8013
TEST_GEN_API_PREFIX=/api/v1

# LLM
TEST_GEN_OPENAI_API_KEY=sk-test-key-for-testing
TEST_GEN_LLM_MODEL=gpt-4-turbo-preview
TEST_GEN_LLM_TEMPERATURE=0.7
TEST_GEN_LLM_MAX_TOKENS=2000

# MongoDB
TEST_GEN_MONGODB_URL=mongodb://localhost:27017
TEST_GEN_MONGODB_DATABASE=nhm_test_generation

# Kafka
TEST_GEN_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TEST_GEN_KAFKA_GROUP_ID=test-generation-group

# Knowledge Graph
TEST_GEN_KNOWLEDGE_GRAPH_URL=http://localhost:8016
TEST_GEN_QDRANT_URL=http://localhost:6333

# Test Generation Settings
TEST_GEN_COVERAGE_TARGET=0.8
TEST_GEN_MAX_TEST_CASES_PER_REQUIREMENT=5
TEST_GEN_DEFAULT_LANGUAGE=python
TEST_GEN_DEFAULT_FRAMEWORK=pytest

# Observabilidade
TEST_GEN_LOG_LEVEL=DEBUG
TEST_GEN_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
