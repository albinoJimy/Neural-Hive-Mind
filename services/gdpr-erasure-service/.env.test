# Environment variables for testing GDPR Erasure Service

# API
API_HOST=0.0.0.0
API_PORT=8010
ENVIRONMENT=testing
LOG_LEVEL=debug
SERVICE_VERSION=1.0.0-test

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=test_nhmgdpr

# Redis
REDIS_URL=redis://localhost:6379/1
REDIS_TOKEN_TTL=3600

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ERASURE_COMMANDS_TOPIC=gdpr.erasure.commands
KAFKA_ERASURE_REPORTS_TOPIC=gdpr.erasure.reports

# Security (development values only!)
VERIFICATION_TOKEN_SALT=test-salt-for-development-only
JWT_SECRET=test-jwt-secret-change-in-production

# Retention
ERASURE_RETENTION_DAYS=90

# CORS
CORS_ORIGINS=*
