# Environment
ENVIRONMENT=dev
DEBUG=false
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8012
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=neural_hive
MONGODB_IMPACTS_COLLECTION=experiment_impacts
MONGODB_EXPERIMENTS_COLLECTION=experiments
MONGODB_HYPOTHESES_COLLECTION=hypotheses

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EXPERIMENT_EVENTS_TOPIC=experiment.events
KAFKA_CONSUMER_GROUP_ID=experiment-impact-analyzer

# Observability
OTEL_ENDPOINT=http://localhost:4317
OTEL_TLS_VERIFY=true
PROMETHEUS_PORT=9092

# Impact Analysis Configuration
SHORT_TERM_WINDOW_DAYS=7
LONG_TERM_WINDOW_DAYS=90
MIN_SAMPLE_SIZE_FOR_IMPACT=100
STATISTICAL_SIGNIFICANCE_THRESHOLD=0.95
CORRELATION_THRESHOLD=0.7
ENABLE_LONG_TERM_ANALYSIS=true
ENABLE_CORRELATION_ANALYSIS=true

# Integration Endpoints
HYPOTHESIS_LIBRARY_URL=http://localhost:8010
OPTIMIZER_AGENTS_URL=http://localhost:8080
LEARNING_DOC_GENERATOR_URL=http://localhost:8011
