# Unified Gateway Environment Variables

# Service
PORT=7999
HOST=0.0.0.0
VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# NLU Service
NLU_SERVICE_ADDRESS=nlu-service:8020
NLU_SERVICE_TIMEOUT=5

# PII Service
PII_SERVICE_ADDRESS=pii-service:8021
PII_SERVICE_TIMEOUT=3

# Rate Limiting (INV-8)
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_REDIS_URL=redis://redis:6379/0

# Flow Router
FLOW_AF_GATEWAY=http://gateway-intencoes:8000
FLOW_G_GATEWAY=http://requirements-engineering:8010
FLOW_H_GATEWAY=http://doc-ingestion:8018
FLOW_ROUTER_TIMEOUT=30

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_PREFIX=unified

# Auth (INV-7)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=RS256
JWKS_URL=http://keycloak:8080/realms/neural-hive/protocol/openid-connect/certs
