# PII Service Environment Variables

# Service
VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8021
HOST=0.0.0.0

# gRPC
GRPC_PORT=9021
GRPC_MAX_WORKERS=10

# MongoDB (INV-13: Audit logging)
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=neural_hive
PII_AUDIT_LOG_COLLECTION=pii_audit_log
AUDIT_LOG_RETENTION_DAYS=90

# Criptografia (INV-14: Unmask reversível AES-256-GCM)
# Se None, usa VAULT_ADDR ou gera chave temporária
ENCRYPTION_KEY_PATH=null
# Vault integration
VAULT_ADDR=null
VAULT_TOKEN=null
VAULT_SECRET_PATH=secret/data/pii-service/encryption-key

# JWT Auth (R-P4: JWT auth required)
JWT_SECRET=change-me
JWT_ALGORITHM=RS256
JWKS_URL=null
JWT_AUTH_REQUIRED=true

# PII Detection
PII_DETECTION_ENABLED=true
PII_DEFAULT_STRATEGY=MASK_PARTIAL
PII_ENABLE_SPACY=true
PII_MIN_CONFIDENCE=0.7

# Unmask Reversível (INV-14)
UNMASK_ENABLED=true
UNMASK_TOKEN_TTL_HOURS=168
UNMASK_MAX_ATTEMPTS=3

# Observabilidade
OTEL_ENDPOINT=null
PROMETHEUS_PORT=9090
