# Environment
ENVIRONMENT=dev
DEBUG=false
LOG_LEVEL=INFO
SERVICE_NAME=hypothesis-library
SERVICE_VERSION=1.0.0

# API Server
API_HOST=0.0.0.0
API_PORT=8010
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# MongoDB
MONGODB_URI=mongodb://mongodb.mongodb.svc.cluster.local:27017
MONGODB_DATABASE=neural_hive
MONGODB_HYPOTHESES_COLLECTION=hypotheses
MONGODB_VERSIONS_COLLECTION=hypothesis_versions
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka.kafka.svc.cluster.local:9092
KAFKA_HYPOTHESIS_EVENTS_TOPIC=hypothesis.events
KAFKA_CONSUMER_GROUP_ID=hypothesis-library

# Observability
OTEL_ENDPOINT=https://opentelemetry-collector.observability.svc.cluster.local:4317
OTEL_TLS_VERIFY=true
PROMETHEUS_PORT=9090

# Hypothesis Configuration
MAX_VERSIONS_PER_HYPOTHESIS=50
AUTO_ARCHIVE_DAYS=180
REQUIRE_APPROVAL_FOR_TESTING=true
ENABLE_VERSIONING=true

# Integration endpoints
EXPERIMENTATION_ENGINE_URL=http://optimizer-agents.optimizer-agents.svc.cluster.local:8080
EXPERIMENTATION_ENGINE_TIMEOUT=30
