# Code Forge MCP Server - Environment para Testes

CODE_FORGE_MCP_SERVICE_NAME=code-forge-mcp-server
CODE_FORGE_MCP_SERVICE_VERSION=1.0.0
CODE_FORGE_MCP_ENVIRONMENT=test

# MongoDB
CODE_FORGE_MCP_MONGODB_URI=mongodb://localhost:27017
CODE_FORGE_MCP_MONGODB_DATABASE=neural_hive_code_forge_test

# Redis
CODE_FORGE_MCP_REDIS_URL=redis://localhost:6379/2

# Template Store
CODE_FORGE_MCP_TEMPLATE_STORE_URL=http://localhost:8009

# LLM Providers (mock para testes)
CODE_FORGE_MCP_OPENAI_API_KEY=test-key
CODE_FORGE_MCP_ANTHROPIC_API_KEY=test-key

# Caching
CODE_FORGE_MCP_CACHE_TTL_SECONDS=3600
CODE_FORGE_MCP_ENABLE_CACHE=true

# Generation limits
CODE_FORGE_MCP_MAX_GENERATION_SIZE_MB=10
CODE_FORGE_MCP_TIMEOUT_SECONDS=300
