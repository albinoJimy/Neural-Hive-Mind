# Analyst MCP Server - Environment para Testes

ANALYST_MCP_SERVICE_NAME=analyst-mcp-server
ANALYST_MCP_SERVICE_VERSION=1.0.0
ANALYST_MCP_ENVIRONMENT=test

# MongoDB
ANALYST_MCP_MONGODB_URI=mongodb://localhost:27017
ANALYST_MCP_MONGODB_DATABASE=neural_hive_analyst_test

# Redis
ANALYST_MCP_REDIS_URL=redis://localhost:6379/1

# Feature Store
ANALYST_MCP_FEATURE_STORE_URL=http://localhost:8006

# Timeouts
ANALYST_MCP_QUERY_TIMEOUT_MS=30000
ANALYST_MCP_ANALYSIS_TIMEOUT_MS=60000

# Paginação
ANALYST_MCP_DEFAULT_PAGE_SIZE=50
ANALYST_MCP_MAX_PAGE_SIZE=1000
