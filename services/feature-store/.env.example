# Feature Store Service Configuration

# Application
ENVIRONMENT=dev
DEBUG=false
LOG_LEVEL=INFO
SERVICE_NAME=feature-store
SERVICE_VERSION=1.0.0

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=neural_hive
MONGODB_FEATURES_COLLECTION=feature_store
MONGODB_MAX_POOL_SIZE=100
MONGODB_TIMEOUT_MS=5000

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Feature Computation
ENABLE_ASYNC_COMPUTATION=true
COMPUTATION_TIMEOUT_SECONDS=30
MAX_PARALLEL_COMPUTATIONS=10

# Validation
VALIDATE_FEATURE_SCHEMA=true
ALLOW_NULL_FEATURES=true

# Observability
OTEL_ENDPOINT=https://opentelemetry-collector.observability.svc.cluster.local:4317
OTEL_TLS_VERIFY=true
PROMETHEUS_PORT=8000

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=200
