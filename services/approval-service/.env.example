# Exemplo de configuracao do Approval Service
# Copie este arquivo para .env e ajuste os valores

# Configuracao da aplicacao
ENVIRONMENT=dev
DEBUG=false
LOG_LEVEL=INFO
SERVICE_NAME=approval-service
SERVICE_VERSION=1.0.0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka.kafka-cluster.svc.cluster.local:9092
KAFKA_CONSUMER_GROUP_ID=approval-service
KAFKA_APPROVAL_REQUESTS_TOPIC=cognitive-plans-approval-requests
KAFKA_APPROVAL_RESPONSES_TOPIC=cognitive-plans-approval-responses

# MongoDB
MONGODB_URI=mongodb://mongodb.mongodb-cluster.svc.cluster.local:27017
MONGODB_DATABASE=neural_hive
MONGODB_COLLECTION=plan_approvals

# Keycloak
# KEYCLOAK_URL=https://keycloak.keycloak.svc.cluster.local:8443  # HTTPS obrigatório em produção
KEYCLOAK_REALM=neural-hive
KEYCLOAK_CLIENT_ID=approval-service
ADMIN_ROLE_NAME=neural-hive-admin

# Observabilidade
OTEL_ENDPOINT=https://opentelemetry-collector.observability.svc.cluster.local:4317
PROMETHEUS_PORT=8000

# Feedback Collection Configuration (ML Continuous Learning)
ENABLE_FEEDBACK_COLLECTION=true
FEEDBACK_MONGODB_COLLECTION=specialist_feedback
MONGODB_OPINIONS_COLLECTION=specialist_opinions
FEEDBACK_RATING_MIN=0.0
FEEDBACK_RATING_MAX=1.0
FEEDBACK_ON_APPROVAL_FAILURE_MODE=log_and_continue

# Active Learning Configuration (Coleta de Feedbacks Balanceados)
ENABLE_ACTIVE_LEARNING=false
ACTIVE_LEARNING_QUEUE_COLLECTION=active_learning_queue
ACTIVE_LEARNING_MIN_INFORMATION_VALUE=0.5
ACTIVE_LEARNING_ENQUEUE_RATE=0.2

# ML Predictor Configuration
ENABLE_ML_PREDICTION=false
ML_MODEL_PATH=/app/ml_models/nhm_approval_model.pkl
ML_AUTO_APPROVE_THRESHOLD=0.8
ML_AUTO_REJECT_THRESHOLD=0.3
