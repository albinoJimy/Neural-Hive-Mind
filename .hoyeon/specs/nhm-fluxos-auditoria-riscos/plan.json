{
  "schema": "plan/v1",
  "meta": {
    "type": "refactor",
    "goal": "Auditoria crítica dos fluxos principais do NHM identificando top-10 riscos arquitecturais com mitigações priorizadas por impacto/esforço",
    "non_goals": [
      "Implementação das mitigações (apenas identificação e priorização)",
      "Refactor de código (análise arquitectural, não de implementação)",
      "Revisão de styling/convenções (riscos estruturais apenas)"
    ]
  },
  "contracts": {
    "artifact": "contracts.md",
    "interfaces": [
      "StorageAPI",
      "KafkaProducerAPI",
      "ConsensusAPI",
      "ApprovalAPI",
      "OrchestrationAPI",
      "ExecutionAPI"
    ],
    "invariants": [
      "INV-1: Independência entre camadas - Gateway nunca chama Workers diretamente",
      "INV-2: Unidirecionalidade dos fluxos - Intenção→Plano→Decisão→Execução nunca reverso sem compensação",
      "INV-3: Isolamento de failures - Falha em specialist não derruba Consensus Orchestrator",
      "INV-4: Ordem estrita dos tópicos Kafka - intentions→plans→decisions nunca out-of-order",
      "INV-5: Imutabilidade de planos aprovados - CognitivePlan aprovado não pode ser modificado",
      "INV-6: Single Source of Truth para estado - MongoDB é autoritativo, Redis é cache apenas",
      "INV-7: Atomicidade de compensação Saga - Rollback compensatório deve ser idempotente",
      "INV-8: Non-blocking do Consensus Orchestrator - Timeout em specialist NÃO bloqueia novos pedidos",
      "INV-9: Exclusividade do Queen Agent - Apenas uma instância ativa",
      "INV-10: Idempotência de execution tickets - Mesmo ticket reprocessado não causa efeitos colaterais"
    ]
  },
  "tasks": [
    {
      "id": "T1",
      "layer": "L0",
      "action": "criar estrutura do relatório de auditoria em markdown com template para top-10 riscos incluindo título, análise multi-factor, conceito de mitigação, passos de implementação e matriz de priorização",
      "fulfills": [
        "R-B5.1",
        "R-B5.2"
      ],
      "depends_on": [],
      "parallel_safe": false,
      "status": "done",
      "summary": "Estrutura do relatório criada em markdown com template top-10"
    },
    {
      "id": "T2",
