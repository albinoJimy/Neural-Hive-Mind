[run]
source =
    libraries/python/neural_hive_ml
    libraries/python/neural_hive_resilience
    libraries/python/neural_hive_risk_scoring
    libraries/python/neural_hive_agent_sdk
    libraries/python/neural_hive_observability
    libraries/python/neural_hive_security
    libraries/python/neural_hive_domain
    # Temporarily excluding neural_hive_specialists - has only 15.5% coverage
    # TODO: Improve test coverage in neural_hive_specialists
    services/
omit =
    */tests/*
    */test_*.py
    */proto_gen/*
    */__pycache__/*
    */setup.py
    */conftest.py
    */.venv/*
    */venv/*
    # Exclude specialists library entirely
    */neural_hive_specialists/*
branch = True
parallel = True
fail_under = 70

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @overload
    # Retry/backoff logic (difícil de testar)
    await asyncio.sleep
    except asyncio.CancelledError

[html]
directory = htmlcov
title = Neural Hive-Mind Unit Coverage Report

[xml]
output = coverage.xml
